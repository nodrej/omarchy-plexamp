{
  "schemaVersion": 1,
  "id": "nodrej.plexamp",
  "name": "Plexamp",
  "version": "0.2.0",
  "author": "nodrej",
  "license": "MIT",
  "description": "Plexamp in the Omarchy bar: album art, scrolling track, and a player panel with scrubbing, shuffle, repeat, and volume.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Plexamp",
    "description": "Now playing from Plexamp with cover art, a scrubbable player panel, shuffle, repeat, and volume.",
    "category": "Media",
    "aliases": ["plexamp", "plex-music"],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "showArt": true,
      "showLabel": true,
      "showProgress": true,
      "labelWidth": 180,
      "labelMode": "scroll",
      "labelFormat": "{title}  ·  {artist}",
      "scrollLabel": true,
      "monitorMode": "all",
      "monitors": [],
      "middleClick": "next",
      "visibility": "when-running",
      "leftClick": "panel",
      "wheelAction": "track",
      "seekStep": 10,
      "launchCommand": "plexamp.desktop"
    },
    "schema": [
      {
        "key": "showArt",
        "type": "boolean",
        "label": "Show cover art",
        "description": "Draw the album cover next to the track in the bar.",
        "defaultValue": true
      },
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show track label",
        "description": "Show title and artist next to the play indicator.",
        "defaultValue": true
      },
      {
        "key": "showProgress",
        "type": "boolean",
        "label": "Show playback progress",
        "description": "Draw a hairline progress bar under the chip.",
        "defaultValue": true
      },
      {
        "key": "labelFormat",
        "type": "string",
        "label": "Label format",
        "description": "Template for the bar label. Placeholders: {title}, {artist}, {album}. A separator left stranded by an empty field is dropped.",
        "defaultValue": "{title}  ·  {artist}"
      },
      {
        "key": "monitorMode",
        "type": "enum",
        "label": "Show on monitors",
        "description": "A bar exists per monitor, so by default the chip appears on all of them.",
        "options": [
          { "value": "all", "label": "All monitors" },
          { "value": "focused", "label": "Focused monitor only" },
          { "value": "named", "label": "Only the monitors listed below" }
        ],
        "defaultValue": "all"
      },
      {
        "key": "monitors",
        "type": "string",
        "label": "Monitor names",
        "description": "Used when \"Show on monitors\" is set to the listed monitors, e.g. [\"DP-1\",\"DP-3\"]. Set with: omarchy bar set nodrej.plexamp monitors '[\"DP-1\"]' --json",
        "defaultValue": ""
      },
      {
        "key": "middleClick",
        "type": "enum",
        "label": "Middle click",
        "options": [
          { "value": "next", "label": "Next track" },
          { "value": "previous", "label": "Previous track" },
          { "value": "playPause", "label": "Play / pause" },
          { "value": "panel", "label": "Open player panel" },
          { "value": "none", "label": "Nothing" }
        ],
        "defaultValue": "next"
      },
      {
        "key": "labelMode",
        "type": "enum",
        "label": "Long track names",
        "description": "How to handle a track label wider than the label width. \"Show in full\" ignores the width limit and lets the chip grow.",
        "options": [
          { "value": "full", "label": "Show in full (no limit)" },
          { "value": "scroll", "label": "Scroll within label width" },
          { "value": "truncate", "label": "Truncate with an ellipsis" }
        ],
        "defaultValue": "scroll"
      },
      {
        "key": "labelWidth",
        "type": "integer",
        "label": "Label width (px)",
        "description": "Maximum label width. Ignored when long track names are shown in full.",
        "min": 60,
        "max": 600,
        "step": 10,
        "defaultValue": 180
      },
      {
        "key": "scrollLabel",
        "type": "boolean",
        "label": "Scroll long labels (legacy)",
        "description": "Superseded by \"Long track names\"; only consulted when that is unset.",
        "defaultValue": true
      },
      {
        "key": "visibility",
        "type": "enum",
        "label": "Show in bar",
        "options": [
          { "value": "when-running", "label": "While Plexamp is running" },
          { "value": "when-playing", "label": "Only while playing" },
          { "value": "always", "label": "Always (launcher when closed)" }
        ],
        "defaultValue": "when-running"
      },
      {
        "key": "leftClick",
        "type": "enum",
        "label": "Left click",
        "options": [
          { "value": "panel", "label": "Open player panel" },
          { "value": "playPause", "label": "Play / pause" }
        ],
        "defaultValue": "panel"
      },
      {
        "key": "wheelAction",
        "type": "enum",
        "label": "Scroll wheel",
        "options": [
          { "value": "track", "label": "Previous / next track" },
          { "value": "volume", "label": "Volume" },
          { "value": "none", "label": "Nothing" }
        ],
        "defaultValue": "track"
      },
      {
        "key": "seekStep",
        "type": "integer",
        "label": "Seek step (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "launchCommand",
        "type": "string",
        "label": "Launch command",
        "description": "Command or .desktop id used to start Plexamp when it is not running.",
        "defaultValue": "plexamp.desktop"
      }
    ]
  }
}
